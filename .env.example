# ============================================================
# Worker Invoice Portal — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Database (Neon PostgreSQL)
# Two URLs required: pooled for runtime, direct for migrations
# ------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------
# Auth (BetterAuth)
# BETTER_AUTH_URL must exactly match the domain users access
# Generate secret: openssl rand -hex 32
# ------------------------------------------------------------
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ------------------------------------------------------------
# Company Info — printed on every invoice PDF
# These have fallbacks but they contain the original owner's
# details — always set your own values.
# ------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME="Your Company Name"
NEXT_PUBLIC_COMPANY_VAT="Your VAT Number"
NEXT_PUBLIC_COMPANY_ADDRESS="Street Address"
NEXT_PUBLIC_COMPANY_CITY="City and Postcode"
NEXT_PUBLIC_COMPANY_COUNTRY="Country"

# ------------------------------------------------------------
# Cron Jobs
# A random string used to authenticate Vercel Cron requests.
# Generate: openssl rand -hex 16
# ------------------------------------------------------------
CRON_SECRET=""

# ------------------------------------------------------------
# Xero Integration (optional)
# Create an OAuth 2.0 app at developer.xero.com
# Tokens are stored in the DB after connecting via Admin UI —
# these three vars are static app credentials only.
# ------------------------------------------------------------
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="https://your-domain.com/api/auth/xero/callback"

# ------------------------------------------------------------
# Slack Notifications (optional)
# Create an Incoming Webhook at api.slack.com/apps
# ------------------------------------------------------------
SLACK_WEBHOOK_URL=""

# ------------------------------------------------------------
# n8n Webhooks (optional)
# Used only by the seed script (lib/seed-webhooks.ts) to
# pre-populate webhook URLs in the database.
# Can also be set directly via Admin Settings UI after deploy.
# ------------------------------------------------------------
N8N_INVOICE_SUBMITTED_URL=""
N8N_INVOICE_UPDATED_URL=""
